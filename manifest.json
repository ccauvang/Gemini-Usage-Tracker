{
    "manifest_version": 3,
    "name": "Gemini Usage Tracker",
    "version": "0.2.2",
    "description": "See your Gemini session and weekly usage limits with reset countdown. No data collected.",
    "minimum_chrome_version": "111",
    "permissions": [
        "declarativeNetRequest",
        "storage"
    ],
    "host_permissions": [
        "https://gemini.google.com/*"
    ],
    "background": {
        "service_worker": "src/background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://gemini.google.com/*"
            ],
            "js": [
                "src/ui.js",
                "src/content.js"
            ],
            "css": [
                "src/ui.css"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://gemini.google.com/*"
            ],
            "js": [
                "src/injector.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        }
    ],
    "action": {
        "default_title": "Gemini Usage Tracker",
        "default_popup": "src/popup/popup.html",
        "default_icon": {
            "16": "assets/icon16.png",
            "32": "assets/icon32.png"
        }
    },
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "frame_headers",
                "enabled": true,
                "path": "src/rules.json"
            }
        ]
    },
    "icons": {
        "16": "assets/icon16.png",
        "32": "assets/icon32.png",
        "48": "assets/icon48.png",
        "128": "assets/icon128.png"
    }
}